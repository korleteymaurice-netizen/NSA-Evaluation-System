<%- include('../partials/head') %><%- include('../partials/navbar') %><div class="admin-shell"><%- include('../partials/sidebar') %><main class="admin-main"><%- include('../partials/alerts') %><h1 class="h2 fw-bold">Appointments</h1><p class="text-muted">Search and manage appointment status.</p><form class="card border-0 shadow-sm p-3 mb-4 row g-2" method="get"><div class="col-md-5"><input class="form-control" name="q" value="<%= query.q||'' %>" placeholder="NSS Personnel name, ID or reference"></div><div class="col-md-3"><input class="form-control" type="date" name="date" value="<%= query.date||'' %>"></div><div class="col-md-3"><select class="form-select" name="status"><option value="">All statuses</option><% ['BOOKED','CHECKED_IN','COMPLETED','MISSED','CANCELLED'].forEach(s=>{ %><option <%= query.status===s?'selected':'' %>><%= s %></option><% }) %></select></div><div class="col-md-1"><button class="btn btn-dark w-100">Go</button></div></form><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>NSS Personnel</th><th>ID</th><th>Reference</th><th>Evaluation</th><th>Date/Time</th><th>Status</th><th>Update</th></tr></thead><tbody><% appointments.forEach(a=>{ %><tr><td><%= a.student.user.name %></td><td><%= a.student.studentId %></td><td><%= a.appointmentReference %></td><td><%= a.evaluation.title %></td><td><%= a.evaluation.date.toLocaleDateString() %><br><small><%= a.timeSlot.startTime.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %></small></td><td><span class="badge status-<%= a.status.toLowerCase() %>"><%= a.status %></span></td><td><form method="post" action="/admin/appointments/<%= a.id %>/status" class="d-flex gap-1 mb-1"><select name="status" class="form-select form-select-sm"><% ['BOOKED','CHECKED_IN','COMPLETED','MISSED','CANCELLED'].forEach(s=>{ %><option <%= a.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn btn-sm btn-dark">Save</button></form><% if(a.status==='BOOKED'){ %><form method="post" action="/admin/appointments/<%= a.id %>/reschedule" class="d-flex gap-1"><select name="timeSlotId" class="form-select form-select-sm"><% a.evaluation.timeSlots.filter(s=>s.startTime>new Date() && (s.appointments.length<s.capacity || s.id===a.timeSlotId)).forEach(s=>{ %><option value="<%= s.id %>" <%= s.id===a.timeSlotId?'selected':'' %>><%= s.startTime.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %> (<%= s.capacity-s.appointments.filter(x=>x.id!==a.id).length %>)</option><% }) %></select><button class="btn btn-sm btn-outline-dark">Move</button></form><% } %></td></tr><% }) %></tbody></table></div></div></main></div><%- include('../partials/footer') %>
