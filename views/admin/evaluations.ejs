<%- include('../partials/head') %><%- include('../partials/navbar') %><div class="admin-shell"><%- include('../partials/sidebar') %><main class="admin-main"><%- include('../partials/alerts') %><div class="d-flex justify-content-between mb-4"><div><h1 class="h2 fw-bold">Evaluations</h1><p class="text-muted">Create evaluation dates and manage slots.</p></div><a href="/admin/evaluations/create" class="btn btn-dark">Create evaluation</a></div><div class="row g-3"><% evaluations.forEach(e=>{const active=e.timeSlots.reduce((n,s)=>n+s.appointments.length,0);%><div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><span class="badge text-bg-light border"><%= e.status %></span><span class="text-muted"><%= e.date.toLocaleDateString() %></span></div><h4 class="mt-3"><%= e.title %></h4><p class="text-muted"><%= e.location %></p><p><strong><%= e.timeSlots.length %></strong> slots · <strong><%= active %></strong> active bookings</p><a href="/admin/evaluations/<%= e.id %>" class="btn btn-outline-dark">Manage</a></div></div></div><% }) %></div></main></div><%- include('../partials/footer') %>
