<%- include('../partials/head') %><%- include('../partials/navbar') %><div class="admin-shell"><%- include('../partials/sidebar') %><main class="admin-main"><%- include('../partials/alerts') %><div class="mb-4"><a href="/admin/evaluations" class="text-decoration-none">← Evaluations</a><h1 class="h2 fw-bold mt-2"><%= evaluation.title %></h1><p class="text-muted"><%= evaluation.date.toLocaleDateString() %> · <%= evaluation.location %> · <%= evaluation.status %></p></div><div class="row g-4"><div class="col-lg-5"><div class="card border-0 shadow-sm"><div class="card-body"><h5 class="fw-bold">Add time slot</h5><form method="post" action="/admin/evaluations/<%= evaluation.id %>/slots" class="row g-2"><div class="col-12"><input type="date" name="date" class="form-control" value="<%= evaluation.date.toISOString().slice(0,10) %>" required></div><div class="col-6"><input type="time" name="startTime" class="form-control" required></div><div class="col-6"><input type="time" name="endTime" class="form-control" required></div><div class="col-12"><input type="number" name="capacity" min="1" class="form-control" placeholder="Capacity" required></div><div class="col-12"><button class="btn btn-dark w-100">Add slot</button></div></form></div></div></div><div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body"><h5 class="fw-bold">Time slots</h5><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Time</th><th>Capacity</th><th>Booked</th><th></th></tr></thead><tbody><% evaluation.timeSlots.forEach(s=>{ %><tr><td><%= s.startTime.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %>–<%= s.endTime.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %></td><td><form method="post" action="/admin/slots/<%= s.id %>/update" class="d-flex gap-1"><input class="form-control form-control-sm" style="width:75px" type="number" min="1" name="capacity" value="<%= s.capacity %>"><button class="btn btn-sm btn-outline-dark">Save</button></form></td><td><%= s.appointments.length %></td><td><form method="post" action="/admin/slots/<%= s.id %>/delete"><button class="btn btn-sm btn-outline-danger confirm-action" data-confirm="Delete this slot?" <%= s.appointments.length?'disabled':'' %>>Delete</button></form></td></tr><% }) %></tbody></table></div></div></div></div></div><div class="card border-0 shadow-sm mt-4"><div class="card-body"><h5 class="fw-bold">Appointments</h5><div class="table-responsive"><table class="table"><thead><tr><th>NSS Personnel</th><th>ID</th><th>Reference</th><th>Status</th></tr></thead><tbody><% evaluation.appointments.forEach(a=>{ %><tr><td><%= a.student.user.name %></td><td><%= a.student.studentId %></td><td><%= a.appointmentReference %></td><td><span class="badge status-<%= a.status.toLowerCase() %>"><%= a.status %></span></td></tr><% }) %></tbody></table></div></div></div></main></div><%- include('../partials/footer') %>
