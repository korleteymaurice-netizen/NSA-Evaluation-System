<%- include('../partials/head') %><%- include('../partials/navbar') %><div class="admin-shell"><%- include('../partials/sidebar') %><main class="admin-main"><div class="card border-0 shadow-sm form-card"><div class="card-body p-4"><h2 class="fw-bold">Create Evaluation</h2><p class="text-muted">Evaluation dates are published automatically for NSS Personnel booking.</p><% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="/admin/evaluations" class="row g-3"><div class="col-md-8"><label class="form-label">Title</label><input class="form-control" name="title" required></div><div class="col-md-6"><label class="form-label">Date</label><input type="date" class="form-control" name="date" required></div><div class="col-md-6"><label class="form-label">Location</label><input class="form-control" name="location" required></div><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="4"></textarea></div><div class="col-12"><button class="btn btn-dark">Create evaluation</button></div></form></div></div></main></div><%- include('../partials/footer') %>
