<%- include('../partials/head') %><%- include('../partials/navbar') %><div class="admin-shell"><%- include('../partials/sidebar') %><main class="admin-main"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2 fw-bold">Reports</h1><p class="text-muted">Export the appointment schedule for operational use.</p></div><div class="d-flex gap-2"><a href="/admin/reports/export.csv" class="btn btn-outline-dark">CSV</a><a href="/admin/reports/export.pdf" class="btn btn-dark">PDF</a></div></div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>NSS Personnel</th><th>ID</th><th>Reference</th><th>Date</th><th>Time</th><th>Status</th></tr></thead><tbody><% appointments.forEach(a=>{ %><tr><td><%= a.student.user.name %></td><td><%= a.student.studentId %></td><td><%= a.appointmentReference %></td><td><%= a.evaluation.date.toLocaleDateString() %></td><td><%= a.timeSlot.startTime.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %></td><td><%= a.status %></td></tr><% }) %></tbody></table></div></div></main></div><%- include('../partials/footer') %>
