<%- include('../partials/head') %><%- include('../partials/navbar') %><div class="admin-shell"><%- include('../partials/sidebar') %><main class="admin-main"><%- include('../partials/alerts') %><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2 fw-bold">Admin Dashboard</h1><p class="text-muted">Evaluation operations at a glance.</p></div><a href="/admin/evaluations/create" class="btn btn-dark">New Evaluation</a></div><div class="row g-3"><% [['Total NSS Personnel',stats.totalStudents],['Total Bookings',stats.totalBookings],['Today',stats.today],['Upcoming',stats.upcoming],['Available Slots',stats.availableSlots],['Full Slots',stats.fullSlots],['Completed',stats.completed],['Missed',stats.missed]].forEach(x=>{ %><div class="col-6 col-xl-3"><div class="stat-card"><span><%= x[0] %></span><strong><%= x[1] %></strong></div></div><% }) %></div><div class="card border-0 shadow-sm mt-4"><div class="card-body"><h5 class="fw-bold">Quick actions</h5><div class="d-flex flex-wrap gap-2"><a href="/admin/appointments" class="btn btn-outline-dark">Manage appointments</a><a href="/admin/students" class="btn btn-outline-dark">View NSS Personnel</a><a href="/admin/reports" class="btn btn-outline-dark">Export reports</a></div></div></div></main></div><%- include('../partials/footer') %>
