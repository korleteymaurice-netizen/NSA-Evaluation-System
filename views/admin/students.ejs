<%- include('../partials/head') %><%- include('../partials/navbar') %><div class="admin-shell"><%- include('../partials/sidebar') %><main class="admin-main"><h1 class="h2 fw-bold">NSS Personnel</h1><p class="text-muted">NSS Personnel with active bookings are shown alongside their current appointment.</p><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Name</th><th>NSS Personnel ID</th><th>Programme</th><th>Email</th><th>Appointment</th></tr></thead><tbody><% students.forEach(s=>{const a=s.appointments[0];%><tr><td><%= s.user.name %></td><td><%= s.studentId %></td><td><%= s.programme||'—' %></td><td><%= s.user.email %></td><td><% if(a){ %><span class="badge status-<%= a.status.toLowerCase() %>"><%= a.status %></span><div class="small"><%= a.evaluation.date.toLocaleDateString() %> · <%= a.appointmentReference %></div><% } else { %><span class="badge text-bg-light border">NOT BOOKED</span><% } %></td></tr><% }) %></tbody></table></div></div></main></div><%- include('../partials/footer') %>
