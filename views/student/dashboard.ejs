<%- include('../partials/head') %><%- include('../partials/navbar') %><main class="container py-4"><%- include('../partials/alerts') %><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2 fw-bold">Welcome, <%= student.user.name.split(' ')[0] %></h1><p class="text-muted mb-0">NSS Personnel dashboard</p></div><a href="/student/evaluation" class="btn btn-dark">Book Evaluation</a></div><% if(current){ %><div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><div class="d-flex justify-content-between"><div><span class="text-muted small">CURRENT APPOINTMENT</span><h3 class="mt-1"><%= current.evaluation.title %></h3><p class="mb-1"><strong><%= current.evaluation.date.toLocaleDateString() %></strong> · <%= current.timeSlot.startTime.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %>–<%= current.timeSlot.endTime.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %></p><p class="text-muted"><%= current.evaluation.location %></p></div><span class="badge status-<%= current.status.toLowerCase() %> align-self-start"><%= current.status %></span></div><a href="/student/appointment/<%= current.id %>" class="btn btn-outline-dark">View details</a></div></div><% } else { %><div class="alert alert-light border">You do not have an active appointment. Choose an available evaluation to book your slot.</div><% } %><h4 class="fw-bold mb-3">Upcoming evaluations</h4><div class="row g-3"><% upcoming.forEach(e=>{ %><div class="col-md-6"><div class="card h-100"><div class="card-body"><span class="text-muted small"><%= e.date.toLocaleDateString() %></span><h5 class="mt-1"><%= e.title %></h5><p class="text-muted"><%= e.location %></p><a href="/student/evaluation" class="btn btn-sm btn-dark">View slots</a></div></div></div><% }) %></div></main><%- include('../partials/footer') %>
