<%- include('../partials/head') %><%- include('../partials/navbar') %><main class="container py-4"><%- include('../partials/alerts') %><div class="confirmation-card mx-auto"><div class="text-center mb-4"><span class="badge text-bg-success">Appointment Confirmed</span><h1 class="h2 fw-bold mt-3">Your evaluation is booked</h1></div><div class="reference"><span>Appointment Reference</span><strong><%= appointment.appointmentReference %></strong></div><div class="row g-3 mt-3"><div class="col-md-6"><div class="detail"><small>NSS Personnel</small><strong><%= appointment.student.user.name %></strong></div></div><div class="col-md-6"><div class="detail"><small>NSS Personnel ID</small><strong><%= appointment.student.studentId %></strong></div></div><div class="col-md-6"><div class="detail"><small>Evaluation date</small><strong><%= appointment.evaluation.date.toLocaleDateString() %></strong></div></div><div class="col-md-6"><div class="detail"><small>Time</small><strong><%= appointment.timeSlot.startTime.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %> – <%= appointment.timeSlot.endTime.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %></strong></div></div><div class="col-12"><div class="detail"><small>Location</small><strong><%= appointment.evaluation.location %></strong></div></div></div><div class="d-flex gap-2 mt-4"><a href="/student/dashboard" class="btn btn-dark">Dashboard</a><a href="/student/history" class="btn btn-outline-dark">History</a><% if(appointment.status==='BOOKED'){ %><a href="/student/evaluation" class="btn btn-outline-dark">Reschedule</a><% } %></div></div></main><%- include('../partials/footer') %>
