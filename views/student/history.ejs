<%- include('../partials/head') %><%- include('../partials/navbar') %><main class="container py-4"><h1 class="h2 fw-bold">Appointment History</h1><p class="text-muted">All your evaluation bookings.</p><div class="table-responsive card border-0 shadow-sm"><table class="table align-middle mb-0"><thead><tr><th>Reference</th><th>Evaluation</th><th>Date</th><th>Time</th><th>Status</th><th></th></tr></thead><tbody><% appointments.forEach(a=>{ %><tr><td><strong><%= a.appointmentReference %></strong></td><td><%= a.evaluation.title %></td><td><%= a.evaluation.date.toLocaleDateString() %></td><td><%= a.timeSlot.startTime.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %></td><td><span class="badge status-<%= a.status.toLowerCase() %>"><%= a.status %></span></td><td><a class="btn btn-sm btn-outline-dark" href="/student/appointment/<%= a.id %>">View</a><% if(a.status==='BOOKED'){ %><form class="d-inline" method="post" action="/student/appointment/<%= a.id %>/cancel"><button class="btn btn-sm btn-outline-danger confirm-action" data-confirm="Cancel this appointment?">Cancel</button></form><% } %></td></tr><% }) %></tbody></table></div></main><%- include('../partials/footer') %>
