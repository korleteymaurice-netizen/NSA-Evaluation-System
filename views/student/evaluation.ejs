<%- include('../partials/head') %><%- include('../partials/navbar') %><main class="container py-4"><%- include('../partials/alerts') %><div class="mb-4"><h1 class="h2 fw-bold">Evaluation Appointment</h1><p class="text-muted">Select a future evaluation and an available time slot.</p></div><% evaluations.forEach(e=>{ %><div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><div class="d-flex flex-wrap justify-content-between gap-2"><div><h4><%= e.title %></h4><p class="mb-1"><%= e.date.toLocaleDateString() %> · <%= e.location %></p><p class="text-muted"><%= e.description||'' %></p></div></div><div class="row g-2 mt-2"><% e.timeSlots.forEach(s=>{ %><div class="col-sm-6 col-lg-4"><form method="post" action="/student/book" class="slot-form"><input type="hidden" name="evaluationId" value="<%= e.id %>"><input type="hidden" name="timeSlotId" value="<%= s.id %>"><button class="slot-button w-100 text-start" <%= s.available<=0?'disabled':'' %>><strong><%= s.startTime.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %> – <%= s.endTime.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %></strong><span class="d-block small mt-1"><%= s.available %> seat<%= s.available===1?'':'s' %> available</span></button></form></div><% }) %></div></div></div><% }) %><% if(!evaluations.length){ %><div class="alert alert-info">No published evaluations are currently available.</div><% } %></main><%- include('../partials/footer') %>
